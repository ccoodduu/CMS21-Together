<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <AssemblyName>TogetherTestHarness</AssemblyName>
        <RootNamespace>TogetherTestHarness</RootNamespace>
        <LangVersion>latest</LangVersion>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <ClientLibs>..\..\CMS21-Together-Client\Libs</ClientLibs>
        <CoreLibs>..\..\CMS21-Together-Core\Libs</CoreLibs>
        <TestManagedDir>$(USERPROFILE)\CMS21-TestInstalls\A\MelonLoader\Managed</TestManagedDir>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="MelonLoader" Private="false"><HintPath>$(ClientLibs)\MelonLoader.dll</HintPath></Reference>
        <Reference Include="0Harmony" Private="false"><HintPath>$(ClientLibs)\0Harmony.dll</HintPath></Reference>
        <Reference Include="UnhollowerBaseLib" Private="false"><HintPath>$(ClientLibs)\UnhollowerBaseLib.dll</HintPath></Reference>
        <Reference Include="Il2Cppmscorlib" Private="false"><HintPath>$(ClientLibs)\Il2Cppmscorlib.dll</HintPath></Reference>
        <Reference Include="Il2CppSystem" Private="false"><HintPath>$(ClientLibs)\Il2CppSystem.dll</HintPath></Reference>
        <Reference Include="Assembly-CSharp" Private="false"><HintPath>$(ClientLibs)\Assembly-CSharp.dll</HintPath></Reference>
        <Reference Include="Assembly-CSharp-firstpass" Private="false"><HintPath>$(ClientLibs)\Assembly-CSharp-firstpass.dll</HintPath></Reference>
        <Reference Include="UnityEngine" Private="false"><HintPath>$(ClientLibs)\UnityEngine.dll</HintPath></Reference>
        <Reference Include="UnityEngine.CoreModule" Private="false"><HintPath>$(ClientLibs)\UnityEngine.CoreModule.dll</HintPath></Reference>
        <Reference Include="UnityEngine.AudioModule" Private="false"><HintPath>$(ClientLibs)\UnityEngine.AudioModule.dll</HintPath></Reference>
        <Reference Include="UnityEngine.PhysicsModule" Private="false"><HintPath>$(ClientLibs)\UnityEngine.PhysicsModule.dll</HintPath></Reference>
        <Reference Include="UnityEngine.ParticleSystemModule" Private="false"><HintPath>$(ClientLibs)\UnityEngine.ParticleSystemModule.dll</HintPath></Reference>
        <Reference Include="UnityEngine.UI" Private="false"><HintPath>$(ClientLibs)\UnityEngine.UI.dll</HintPath></Reference>
        <Reference Include="UnityEngine.ScreenCaptureModule" Private="false"><HintPath>$(TestManagedDir)\UnityEngine.ScreenCaptureModule.dll</HintPath></Reference>
        <Reference Include="UnityEngine.ImageConversionModule" Private="false"><HintPath>$(ClientLibs)\UnityEngine.ImageConversionModule.dll</HintPath></Reference>
        <Reference Include="Unity.RenderPipelines.HighDefinition.Runtime" Private="false"><HintPath>$(TestManagedDir)\Unity.RenderPipelines.HighDefinition.Runtime.dll</HintPath></Reference>
        <Reference Include="Rewired_Core" Private="false"><HintPath>$(TestManagedDir)\Rewired_Core.dll</HintPath></Reference>
        <Reference Include="Newtonsoft.Json" Private="false"><HintPath>$(CoreLibs)\Newtonsoft.Json.dll</HintPath></Reference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\CMS21-Together-Client\CMS21-Together.csproj" Private="false" />
        <ProjectReference Include="..\..\CMS21-Together-Core\CMS21-Together-Core.csproj" Private="false" />
    </ItemGroup>

</Project>
